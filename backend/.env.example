# =============================================================================
# Backend secrets — copy to backend/.env (never commit backend/.env)
#
#   cp backend/.env.example backend/.env
#
# Generate secrets:
#   openssl rand -base64 48   # JWT_SECRET (min 32 chars recommended)
#   openssl rand -base64 24   # ADMIN_PASSWORD
# =============================================================================

MONGO_URL=mongodb://localhost:27017
DB_NAME=aia_legnano

# Use a long random secret in production (min 32 chars). Never commit real secrets.
JWT_SECRET=<generate-random-256bit-base64>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

ADMIN_EMAIL=admin@aia-legnano.it
ADMIN_PASSWORD=<generate-strong-password>
ADMIN_NAME=Amministratore

# Comma-separated origins (do not use * with credentials). Vercel *.vercel.app is also allowed via regex.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aia-virid.vercel.app
# Public origin of this API (no trailing slash). Leave empty in local/tunnel
# so /api/uploads stays same-origin. In production set e.g. https://api.aia-legnano.it
PUBLIC_API_URL=

# Optional: force media URL strategy (relative|absolute). Empty = auto
# MEDIA_URL_MODE=relative
# UPLOAD_DIR=   # leave unset to use backend/uploads
# STORAGE_BACKEND=auto   # auto=GridFS on Atlas (mongodb+srv), local disk otherwise
#                          # gridfs | local | s3

# Optional email (Resend) — verifica il dominio aia-legnano.it su resend.com
# Mittente istituzionale (invio a sezione + associati opt-in):
RESEND_API_KEY=
SENDER_EMAIL=noreply@aia-legnano.it
# Casella sezione: contatti sito, candidature corso, commenti comunicazioni
NOTIFY_EMAIL=legnano@aia-figc.it
# URL pubblico del frontend (link nelle email)
PORTAL_FRONTEND_URL=https://aia-virid.vercel.app

# Designations sync
DESIGNATIONS_AUTO_SYNC=true
DESIGNATIONS_SYNC_INTERVAL_HOURS=12
DESIGNATIONS_SYNC_ON_STARTUP=true
DESIGNATIONS_LEGNANO_GARE=3-270
DESIGNATIONS_FILTER_SECTION=Legnano
DESIGNATIONS_CRAWL_ALL_HUBS=false

# Optional Instagram gallery import
INSTAGRAM_SESSION_ID=
