generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  codiceMeccanografico String   @unique
  email                String?
  passwordHash         String
  nome                 String
  cognome              String
  ruolo              String   @default("ASSOCIATO")
  foto               String?
  biografia          String?
  telefono           String?
  emailVisibile      Boolean  @default(false)
  telefonoVisibile   Boolean  @default(false)
  categoria          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  designazioni        Designazione[]
  presenze            PresenzaEvento[]
  calendarioPersonale CalendarioPersonale[]
  preferiti           Preferito[]
  notifiche           Notifica[]
  traguardi           Traguardo[]
  media               Media[]
  messaggiInviati     Messaggio[] @relation("MessaggiInviati")
  messaggiRicevuti    Messaggio[] @relation("MessaggiRicevuti")
  successiPersonali   SuccessoPersonale[]
}

model Evento {
  id         String    @id @default(cuid())
  titolo     String
  tipo       String
  dataInizio DateTime
  dataFine   DateTime?
  luogo      String?
  note       String?
  createdAt  DateTime  @default(now())

  presenze   PresenzaEvento[]
  calendario CalendarioPersonale[]
}

model Designazione {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campionato   String
  girone       String?
  giornata     String?
  ruolo        String
  squadraCasa  String
  squadraTrasf String
  dataGara     DateTime
  luogo        String?
  stato        String   @default("assegnata")
  createdAt    DateTime @default(now())
}

model RTO {
  id          String   @id @default(cuid())
  titolo      String
  data        DateTime
  luogo       String?
  descrizione String?
  createdAt   DateTime @default(now())

  documenti DocumentoTecnico[]
}

model DocumentoTecnico {
  id          String   @id @default(cuid())
  titolo      String
  tipo        String
  url         String?
  filePath    String?
  descrizione String?
  rtoId       String?
  rto         RTO?     @relation(fields: [rtoId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Quiz {
  id          String   @id @default(cuid())
  titolo      String
  descrizione String?
  url         String?
  createdAt   DateTime @default(now())
}

model Gara {
  id           String   @id @default(cuid())
  userId       String
  categoria    String
  girone       String?
  ruolo        String
  squadraCasa  String
  squadraTrasf String
  dataGara     DateTime
  risultato    String?
  stagione     String
  createdAt    DateTime @default(now())

  @@index([userId, stagione])
}

model NewsTecnica {
  id        String   @id @default(cuid())
  titolo    String
  contenuto String
  citazioni String?
  categoria String?
  createdAt DateTime @default(now())
}

model Comunicazione {
  id        String   @id @default(cuid())
  titolo    String
  contenuto String
  createdAt DateTime @default(now())
}

model Notifica {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testo     String
  tipo      String
  link      String?
  letta     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Traguardo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo        String
  data        DateTime
  descrizione String
  icona       String?
  createdAt   DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titolo    String
  url       String
  eventoId  String?
  createdAt DateTime @default(now())
}

model Messaggio {
  id             String   @id @default(cuid())
  mittenteId     String
  destinatarioId String
  mittente       User     @relation("MessaggiInviati", fields: [mittenteId], references: [id], onDelete: Cascade)
  destinatario   User     @relation("MessaggiRicevuti", fields: [destinatarioId], references: [id], onDelete: Cascade)
  testo          String
  letto          Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Preferito {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo       String
  elementoId String
  createdAt  DateTime @default(now())

  @@unique([userId, tipo, elementoId])
}

model CalendarioPersonale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  reminder  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, eventoId])
}

model PresenzaEvento {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  stato     String   @default("NON_RISPOSTO")
  updatedAt DateTime @updatedAt

  @@unique([userId, eventoId])
}

model SuccessoPersonale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titolo    String
  contenuto String
  data      DateTime @default(now())
}
