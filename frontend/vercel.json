{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aia-production-00a9.up.railway.app/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://aia-production-00a9.up.railway.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://aia-production-00a9.up.railway.app/robots.txt"
    },
    {
      "source": "/docs",
      "destination": "https://aia-production-00a9.up.railway.app/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://aia-production-00a9.up.railway.app/docs/:path*"
    },
    {
      "source": "/redoc",
      "destination": "https://aia-production-00a9.up.railway.app/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://aia-production-00a9.up.railway.app/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
