# =============================================================================
# AIA Legnano — environment template (ROOT)
# =============================================================================
# Copy this file to `.env` in the repository root for `docker compose`:
#
#   cp .env.example .env
#
# For local backend without Docker, prefer `backend/.env` instead:
#
#   cp backend/.env.example backend/.env
#
# NEVER commit real `.env` files. Generate strong secrets before production.
#
# Generate examples:
#   openssl rand -base64 48          # JWT_SECRET
#   openssl rand -base64 24          # ADMIN_PASSWORD
# =============================================================================

# --- Required secrets (docker compose will refuse to start without these) ---
ADMIN_EMAIL=legnano@aia-figc.it
ADMIN_PASSWORD=<generate-strong-password>
JWT_SECRET=<generate-random-256bit-base64>

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
ADMIN_NAME=Amministratore

# --- Database (inside docker compose, mongo hostname is "mongo") ---
MONGO_URL=mongodb://mongo:27017
DB_NAME=aia_legnano

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.aia-legnano.it,https://aia-legnano.it,https://aia-virid.vercel.app
# Public API origin for browsers (no trailing slash). Production: https://api.aia-legnano.it
PUBLIC_API_URL=
REACT_APP_BACKEND_URL=

# --- Optional email (Resend) — dominio aia-legnano.it verificato ---
RESEND_API_KEY=
SENDER_EMAIL=noreply@aia-legnano.it
NOTIFY_EMAIL=legnano@aia-figc.it
REPLY_TO_EMAIL=legnano@aia-figc.it
PORTAL_FRONTEND_URL=https://www.aia-legnano.it

# --- Designations sync ---
DESIGNATIONS_AUTO_SYNC=true
DESIGNATIONS_SYNC_INTERVAL_HOURS=6
DESIGNATIONS_LEGNANO_GARE=3-270
DESIGNATIONS_FILTER_SECTION=Legnano
DESIGNATIONS_CRAWL_ALL_HUBS=false
DESIGNATIONS_NATIONAL_HUBS=canc,cand,can5elite,can5,canbs

# --- Optional Instagram gallery import ---
INSTAGRAM_SESSION_ID=
